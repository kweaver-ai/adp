{
  "input_schema": {
    "type": "object",
    "properties": {
      "ot_id": {
        "type": "string",
        "description": "对象类型ID"
      },
      "query": {
        "type": "string",
        "description": "用户问题或关键词（用于生成 dynamic_params）。缺失会导致动态参数生成失败"
      },
      "unique_identities": {
        "type": "array",
        "description": "实例唯一标识列表（对象主键/唯一标识键值对），支持批量",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "properties": {
        "type": "array",
        "description": "逻辑属性名列表（metric/operator）。必须为 Schema 中存在的逻辑属性",
        "items": { "type": "string" }
      },
      "additional_context": {
        "type": "string",
        "description": "补充上下文信息（可选）。建议传 JSON 字符串，包含时间范围/对象上下文等，例如 {\"instant\":false,\"start\":<ms>,\"end\":<ms>,\"step\":\"1d\"}"
      },
      "options": {
        "type": "object",
        "description": "高级选项（可选）。仅支持 return_debug / max_repair_rounds / max_concurrency",
        "properties": {
          "return_debug": {
            "type": "boolean",
            "description": "是否返回 debug 信息（dynamic_params、agent_info 等）。默认 false"
          },
          "max_repair_rounds": {
            "type": "integer",
            "description": "动态参数修复轮数上限。默认 1"
          },
          "max_concurrency": {
            "type": "integer",
            "description": "并发生成动态参数的最大并发数。默认 4"
          }
        },
        "additionalProperties": false
      }
    },
    "required": ["ot_id", "query", "unique_identities", "properties"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "datas": {
        "type": "array",
        "description": "逻辑属性结果列表",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "debug": {
        "type": "object",
        "description": "调试信息（return_debug=true 时返回）",
        "additionalProperties": true
      }
    }
  }
}
